# Copy to .env and fill with your own values. Never commit .env or service-account keys.
PORT=3000

# Firebase web app (public web API key is not a server secret, but use your own project)
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=

# Google reCAPTCHA
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Sessions: generate a long random value
SESSION_SECRET=
COOKIE_SECURE=false

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 3x-ui bearer-token API
# Use the full panel base URL, including any configured web base path.
XUI_BASE_URL=https://your-panel.example.com:2053/your-panel-base-path
XUI_API_TOKEN=
XUI_INBOUND_ID=1
# Optional public hostname clients should connect to (defaults to XUI_BASE_URL hostname)
XUI_PUBLIC_HOST=
# Trial limits: 300 GB, one IP, three days by default
XUI_TRIAL_DATA_GB=300
XUI_TRIAL_DAYS=3

# SNI hostnames must be valid domain names that your inbound/server configuration supports.
XUI_SNI_TIKTOK=tiktok.com
XUI_SNI_YOUTUBE=youtube.com
XUI_SNI_ZOOM=zoom.us
XUI_SNI_NETFLIX=netflix.com
